---
import { contact } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---
<div class="prl-topbar bg-dark text-light px-3 px-lg-5" id="page-top">
  <div class="prl-topbar-contact">
    <span><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>{contact.address}</span>
    <span><i class="fa-solid fa-phone me-2" aria-hidden="true"></i>{contact.phone}</span>
    <span><i class="fa-solid fa-envelope me-2" aria-hidden="true"></i>{contact.email}</span>
  </div>
  <SocialLinks />
</div>

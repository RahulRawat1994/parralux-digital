  <p class="text-center small text-muted">Sample vendor logos — for layout preview only</p>
  <div class="vendor-track" tabindex="0" role="region" aria-label="Nine sample vendor logos; scroll to see more">{Array.from({length: 9}, (_, i) => <img src={`/images/vendor-${i+1}.jpg`} width="150" height="50" alt={`Sample vendor logo ${i+1}`} loading="lazy" />)}</div>

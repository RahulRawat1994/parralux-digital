# Server-only settings. Copy to .env; never put credentials in PUBLIC_ variables.
# Set this to the exact public origin in production; leave empty for local development.
SITE_URL=
SMTP_HOST=
SMTP_PORT=587
# false = required STARTTLS (usually 587); true = implicit TLS (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender email address, without a display name.
SMTP_FROM=
# One company inbox receives Contact, Quote, and Email Signup requests.
MAIL_TO=
